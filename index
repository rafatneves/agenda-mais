/* ---- DRE completo ---- */
function pintarDRE(){
  const meses=[]; const now=new Date();
  for(let i=5;i>=0;i--){ const d=new Date(now.getFullYear(),now.getMonth()-i,1); meses.push(d.toISOString().slice(0,7)); }
  const linhas=meses.map(m=>{
    const doMes=lancData.filter(l=>l.data.slice(0,7)===m);
    const receita=doMes.filter(l=>l.tipo==='receita').reduce((s,l)=>s+Number(l.valor||0),0);
    const cmv=doMes.filter(l=>l.tipo==='despesa'&&l.natureza==='cmv').reduce((s,l)=>s+Number(l.valor||0),0);
    const fixa=doMes.filter(l=>l.tipo==='despesa'&&l.natureza==='fixa').reduce((s,l)=>s+Number(l.valor||0),0);
    const variavel=doMes.filter(l=>l.tipo==='despesa'&&(!l.natureza||l.natureza==='variavel')).reduce((s,l)=>s+Number(l.valor||0),0);
    const margemBruta=receita-cmv; const despOp=fixa+variavel; const resultado=margemBruta-despOp;
    return {m,receita,cmv,fixa,variavel,despOp,margemBruta,resultado};
  });
  const atual=linhas[linhas.length-1];
  $('content').innerHTML=`
    ${financeiroTabsHTML()}
    <div class="panel" style="max-width:520px;margin-bottom:16px">
      <div class="panelHead"><h2>DRE — ${new Date(atual.m+'-01').toLocaleDateString('pt-BR',{month:'long',year:'numeric'})}</h2>
        <button class="btn sm" onclick="exportarDRECSV()">Exportar CSV</button></div>
      <div class="modalBody" style="font-size:13.5px">
        <div style="display:flex;justify-content:space-between;padding:6px 0"><span>Receita bruta</span><b class="mono">${BRL(atual.receita)}</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;color:var(--coral)"><span>(−) CMV (insumos)</span><b class="mono">${BRL(atual.cmv)}</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid var(--line-soft);font-weight:600"><span>Margem bruta</span><b class="mono">${BRL(atual.margemBruta)}</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;color:var(--coral)"><span>(−) Despesas fixas</span><b class="mono">${BRL(atual.fixa)}</b></div>
        <div style="display:flex;justify-content:space-between;padding:6px 0;color:var(--coral)"><span>(−) Despesas variáveis</span><b class="mono">${BRL(atual.variavel)}</b></div>
        <div style="display:flex;justify-content:space-between;padding:10px 0 0;border-top:1px solid var(--line);font-weight:700;font-size:15px"><span>Resultado operacional</span><b class="mono" style="color:${atual.resultado>=0?'var(--teal)':'var(--coral)'}">${BRL(atual.resultado)}</b></div>
      </div>
    </div>
    <div class="panel">
      <div class="panelHead"><h2>Comparativo — últimos 6 meses</h2></div>
      <table class="tbl"><thead><tr><th>Mês</th><th>Receita</th><th>CMV</th><th>Margem bruta</th><th>Desp. operacional</th><th>Resultado</th></tr></thead><tbody>
        ${linhas.map(l=>`<tr><td style="text-transform:capitalize">${new Date(l.m+'-01').toLocaleDateString('pt-BR',{month:'short',year:'2-digit'})}</td>
          <td class="mono">${BRL(l.receita)}</td><td class="mono">${BRL(l.cmv)}</td><td class="mono">${BRL(l.margemBruta)}</td><td class="mono">${BRL(l.despOp)}</td>
          <td class="mono" style="font-weight:600;color:${l.resultado>=0?'var(--teal)':'var(--coral)'}">${BRL(l.resultado)}</td></tr>`).join('')}
      </tbody></table>
    </div>`;
  window._dreLinhas=linhas;
}
function exportarDRECSV(){
  const linhas=window._dreLinhas||[];
  exportarCSV('dre_6meses.csv',[
    {titulo:'Mês',get:l=>l.m},{titulo:'Receita bruta',get:l=>l.receita.toFixed(2).replace('.',',')},
