      <button class="btn primary" onclick="salvarProcedimento(${id?`'${id}'`:'null'})">Salvar</button>
    </div>
  `);
}
function adicionarItemProc(id){
  const sel=$('prItemSel'); const estoqueId=sel.value; const qtd=parseFloat($('prItemQtd').value)||0;
  if(!estoqueId||qtd<=0){showToast('Escolha um item e uma quantidade.','err');return;}
  const existente=procItensTemp.find(it=>it.estoqueId===estoqueId);
  if(existente) existente.qtd=Number(existente.qtd)+qtd; else procItensTemp.push({estoqueId,qtd});
  renderModalProcedimento(id||null);
}
function removerItemProc(idx,id){
  procItensTemp.splice(idx,1);
  renderModalProcedimento(id||null);
}
function atualizarPrecoModal(){
  const custo=procItensTemp.reduce((s,it)=>{ const e=procEstoque.find(x=>x.id===it.estoqueId); return s+(e?Number(e.custoUnitario||0)*Number(it.qtd||0):0); },0);
