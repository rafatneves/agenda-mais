  $('content').innerHTML=`
    ${contasAtrasadas.length?`<div class="card" style="background:var(--coral-soft);border:none;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center">
      <span style="font-size:13.5px;color:var(--coral)"><b>${contasAtrasadas.length} conta(s) atrasada(s)</b> — total de ${BRL(contasAtrasadas.reduce((s,c)=>s+Number(c.valor||0),0))}</span>
      <button class="btn sm" onclick="goTab('financeiro')">Ver contas</button>
    </div>`:''}
    <div class="grid cards4">
      <div class="card kpi"><div class="lbl">Consultas hoje</div><div class="val">${hojeAgend.length}</div><div class="sub">${pacientes.length} pacientes cadastrados</div></div>
      <div class="card kpi"><div class="lbl">Receita do mês</div><div class="val">${BRL(receitaMes)}</div><div class="sub">até ${fmtData(hoje)}</div></div>
      <div class="card kpi"><div class="lbl">Despesas do mês</div><div class="val">${BRL(despesaMes)}</div><div class="sub">materiais, contas, etc.</div></div>
      <div class="card kpi"><div class="lbl">Lucro do mês</div><div class="val" style="color:${lucroMes>=0?'var(--teal)':'var(--coral)'}">${BRL(lucroMes)}</div><div class="sub">receita − despesas</div></div>
    </div>

    <div class="grid" style="grid-template-columns:1.4fr 1fr;margin-top:16px" id="dashBottom">
      <div class="panel">
        <div class="panelHead"><h2>Hoje na agenda</h2><button class="btn sm" onclick="goTab('agenda')">Ver agenda</button></div>
        ${hojeAgend.length? `<table class="tbl"><thead><tr><th>Horário</th><th>Paciente</th><th>Profissional</th><th>Status</th></tr></thead><tbody>
          ${hojeAgend.sort((a,b)=>a.hora.localeCompare(b.hora)).map(a=>`<tr><td class="mono">${a.hora}</td><td>${a.pacienteNome}</td><td>${a.profissional||'—'}</td><td><span class="badge ${a.status}">${statusLabel(a.status)}</span></td></tr>`).join('')}
        </tbody></table>` : `<div class="empty"><div class="big">Nada marcado pra hoje</div>Aproveite pra revisar a agenda da semana.</div>`}
      </div>
      <div class="panel">
        <div class="panelHead"><h2>Estoque baixo</h2><button class="btn sm" onclick="goTab('estoque')">Ver estoque</button></div>
        ${baixoEstoque.length? `<table class="tbl"><thead><tr><th>Item</th><th>Qtd.</th></tr></thead><tbody>
