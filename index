    if(onbMode==='create'){
      const nome=document.getElementById('onbNome').value.trim();
      if(!nome){err.textContent='Digite o nome da clínica.';err.style.display='block';return;}
      const codigo=slugCodigo(nome);
      const {error:e1}=await sb.from('clinicas').insert({grp:codigo,nome});
