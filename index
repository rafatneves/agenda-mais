.kpi .lbl{font-size:11.5px;color:var(--gray);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px}
.kpi .val{font-family:'Newsreader',serif;font-size:26px;font-weight:600}
.kpi .sub{font-size:12px;color:var(--ink-soft);margin-top:4px}
