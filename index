function slugCodigo(nome){
  const base=(nome||'clinica').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^A-Z0-9]/g,'').slice(0,10)||'CLINICA';
  return base+Math.random().toString(36).slice(2,6).toUpperCase();
}
async function doOnboard(){
  const err=document.getElementById('onbErr'); err.style.display='none';
