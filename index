.modalBg{position:fixed;inset:0;background:#20281f66;display:none;align-items:center;justify-content:center;z-index:100;padding:20px}
.modalBg.on{display:flex}
.modal{background:#fff;border-radius:var(--radius-lg);max-width:520px;width:100%;max-height:88vh;overflow:auto;
