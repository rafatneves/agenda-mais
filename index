<style>
:root{
  --paper:#F6F3EA; --paper2:#EFEADB; --ink:#20281F; --ink-soft:#5B6358;
  --line:#DCD6C4; --line-soft:#E8E2D0;
  --teal:#2F6659; --teal-soft:#DEEAE3;
  --coral:#C1543F; --coral-soft:#F3DED7;
  --amber:#B9862E; --amber-soft:#F1E4C6;
  --blue:#3B5C78; --blue-soft:#DFE6EE;
  --gray:#8B8272;
  --shadow:0 1px 0 #fff9 inset, 0 10px 28px -18px #20281F4d;
  --sidebar-w:216px; --header-h:60px;
  --radius-lg:16px; --radius-md:11px; --radius-sm:7px;
  font-family:'Inter',system-ui,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--paper);color:var(--ink);height:100%}
body{-webkit-font-smoothing:antialiased;font-size:14px;line-height:1.45}
h1,h2,h3,.disp{font-family:'Newsreader',serif;font-weight:600;letter-spacing:-.01em}
.mono{font-family:'IBM Plex Mono',monospace}
button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}
button{cursor:pointer}
a{color:var(--teal)}
::selection{background:var(--teal-soft)}

#gate{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:
  radial-gradient(1200px 600px at 15% -10%, #ffffff 0%, transparent 55%), var(--paper);}
.gateCard{width:100%;max-width:400px;background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);
  box-shadow:var(--shadow);padding:32px 28px}
.gateLogo{display:flex;align-items:center;gap:10px;margin-bottom:22px}
.gateLogo .mark{width:34px;height:34px;border-radius:9px;background:var(--teal);color:#fff;display:flex;
  align-items:center;justify-content:center;font-family:'Newsreader',serif;font-weight:700;font-size:18px}
.gateLogo .name{font-family:'Newsreader',serif;font-weight:600;font-size:20px}
.gateTitle{font-size:15px;color:var(--ink-soft);margin:0 0 20px}
.gateLab{display:block;font-size:12px;font-weight:600;color:var(--ink-soft);margin:14px 0 6px;text-transform:uppercase;letter-spacing:.04em}
.gateInp{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--paper);
  outline:none;transition:border-color .15s}
.gateInp:focus{border-color:var(--teal)}
.gateBtn{width:100%;margin-top:20px;padding:12px;border:none;border-radius:var(--radius-sm);background:var(--teal);
  color:#fff;font-weight:600;font-size:14px;transition:opacity .15s}
.gateBtn:hover{opacity:.92}
.gateBtn.ghost{background:transparent;color:var(--teal);border:1px solid var(--line);margin-top:8px}
.gateSwitch{margin-top:18px;text-align:center;font-size:13px;color:var(--ink-soft)}
.gateSwitch a{cursor:pointer;font-weight:600;text-decoration:none}
.gateError{background:var(--coral-soft);color:var(--coral);border-radius:var(--radius-sm);padding:9px 11px;font-size:13px;margin-top:14px;display:none}
.gateTabs{display:flex;gap:6px;background:var(--paper2);padding:4px;border-radius:10px;margin-bottom:18px}
.gateTab{flex:1;text-align:center;padding:8px;border-radius:8px;font-size:13px;font-weight:600;color:var(--ink-soft);transition:.15s;border:none;background:none}
.gateTab.on{background:#fff;color:var(--ink);box-shadow:var(--shadow)}
.gateFoot{margin-top:22px;text-align:center}
.gateFoot a{font-size:11.5px;color:var(--gray);text-decoration:none}

#app{display:none}
#app.on{display:block}
.sidebar{position:fixed;left:0;top:0;bottom:0;width:var(--sidebar-w);background:#fff;border-right:1px solid var(--line);
  display:flex;flex-direction:column;padding:18px 12px;z-index:20}
.sbBrand{display:flex;align-items:center;gap:9px;padding:6px 8px 20px}
.sbBrand .mark{width:28px;height:28px;border-radius:8px;background:var(--teal);color:#fff;display:flex;align-items:center;
