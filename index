async function salvarProcedimento(id){
  const nome=$('prNome').value.trim();
  if(!nome){showToast('Digite o nome do procedimento.','err');return;}
  const obj={id:id||uid(),nome,itens:procItensTemp,margem:parseFloat($('prMargem').value)||0,precoManual:parseFloat($('prPrecoManual').value)||0};
