  lancData=lancData.filter(x=>x.id!==id);
  await saveList('lancamentos',lancData);
  closeModal(); showToast('Lançamento excluído.','ok'); pintarFinanceiro();
}

/* ---- Contas a pagar / receber (fluxo de caixa) ---- */
function pintarContas(){
  const hoje=hojeISO();
  const pendentes=contasData.filter(c=>c.status!=='pago').sort((a,b)=>a.vencimento.localeCompare(b.vencimento));
  const pagas=contasData.filter(c=>c.status==='pago').sort((a,b)=>b.vencimento.localeCompare(a.vencimento)).slice(0,15);
  const totalPagar=pendentes.filter(c=>c.tipo==='pagar').reduce((s,c)=>s+Number(c.valor||0),0);
