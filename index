<script>
/* ================= AGENDA ================= */
let agendaData=[]; let agendaPacientes=[]; let agendaSelDia=hojeISO(); let agendaMesRef=new Date(); let agendaProcedimentos=[]; let agendaEstoque=[];
function custoProcedimentoAgenda(p){
  return (p.itens||[]).reduce((s,it)=>{ const e=agendaEstoque.find(x=>x.id===it.estoqueId); return s+(e?Number(e.custoUnitario||0)*Number(it.qtd||0):0); },0);
}
function precoSugeridoAgenda(p){
  const custo=custoProcedimentoAgenda(p); const m=Number(p.margem||0);
  return (m>0&&m<100) ? custo/(1-m/100) : custo;
}
const HORA_INI=7, HORA_FIM=20;

async function renderAgenda(){
  $('topbarActs').innerHTML=`<button class="btn sm" onclick="exportarAgendaCSV()">Exportar CSV</button> <button class="btn primary" onclick="abrirModalAgendamento()">+ Novo agendamento</button>`;
  $('content').innerHTML='<div class="empty">Carregando…</div>';
  [agendaData,agendaPacientes,agendaProcedimentos,agendaEstoque]=await Promise.all([loadList('agendamentos'),loadList('pacientes'),loadList('procedimentos'),loadList('estoque')]);
  pintarAgenda();
}
function exportarAgendaCSV(){
  exportarCSV('agenda.csv',[
    {titulo:'Data',get:a=>fmtData(a.data)},{titulo:'Hora',campo:'hora'},{titulo:'Paciente',campo:'pacienteNome'},
    {titulo:'Tipo',campo:'tipo'},{titulo:'Profissional',campo:'profissional'},{titulo:'Status',get:a=>statusLabel(a.status)}
  ],[...agendaData].sort((a,b)=>a.data.localeCompare(b.data)||a.hora.localeCompare(b.hora)));
}
function pintarAgenda(){
  $('content').innerHTML=`<div class="agendaWrap"><div class="agendaCal">${miniCalHTML()}</div><div class="dayTimeline" id="dayTimeline">${dayTimelineHTML()}</div></div>`;
}
function miniCalHTML(){
  const ref=agendaMesRef, y=ref.getFullYear(), m=ref.getMonth();
  const primeiro=new Date(y,m,1), ultimoDia=new Date(y,m+1,0).getDate();
  const offset=primeiro.getDay();
  const hoje=hojeISO();
  let dias='';
  for(let i=0;i<offset;i++) dias+=`<div></div>`;
  for(let d=1;d<=ultimoDia;d++){
    const iso=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    let cls='mcDay'; if(iso===hoje) cls+=' today'; if(iso===agendaSelDia) cls+=' sel';
    dias+=`<div class="${cls}" onclick="agendaSelDia='${iso}';pintarAgenda()">${d}</div>`;
  }
  return `<div class="miniCal">
    <div class="mcHead"><button class="mcNav" onclick="mudaMes(-1)">‹</button><span>${ref.toLocaleDateString('pt-BR',{month:'long',year:'numeric'})}</span><button class="mcNav" onclick="mudaMes(1)">›</button></div>
    <div class="mcGrid">${['D','S','T','Q','Q','S','S'].map(x=>`<div class="mcDow">${x}</div>`).join('')}${dias}</div>
    <button class="btn sm" style="width:100%;margin-top:12px" onclick="agendaSelDia=hojeISO();agendaMesRef=new Date();pintarAgenda()">Hoje</button>
  </div>`;
}
function mudaMes(delta){ agendaMesRef=new Date(agendaMesRef.getFullYear(),agendaMesRef.getMonth()+delta,1); pintarAgenda(); }
function dayTimelineHTML(){
  const doDia=agendaData.filter(a=>a.data===agendaSelDia).sort((a,b)=>a.hora.localeCompare(b.hora));
  let rows='';
  for(let h=HORA_INI;h<HORA_FIM;h++){
    const hstr=String(h).padStart(2,'0')+':00';
    const nesteHora=doDia.filter(a=>a.hora.slice(0,2)===String(h).padStart(2,'0'));
    rows+=`<div class="dtRow"><div class="dtHour">${hstr}</div><div class="dtSlot">
      ${nesteHora.map(a=>apptCardHTML(a)).join('')}
    </div></div>`;
  }
  const titulo=new Date(agendaSelDia+'T00:00:00').toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'});
  return `<div style="padding:12px 16px 4px;font-weight:600;font-family:'Newsreader',serif;font-size:15px;text-transform:capitalize">${titulo}</div>${rows}`;
}
function apptCardHTML(a){
  return `<div class="apptCard ${a.status}" onclick="abrirModalAgendamento('${a.id}')">
    <div><div class="who">${a.pacienteNome}</div><div class="what">${a.tipo||'Consulta'}${a.profissional?' · '+a.profissional:''} · ${a.hora}</div></div>
    <div class="apptActs">
      <button class="iconBtn" title="Lembrete WhatsApp" onclick="event.stopPropagation();lembreteWhats('${a.id}')">💬</button>
    </div>
  </div>`;
}
function abrirModalAgendamento(id){
  const a=id?agendaData.find(x=>x.id===id):null;
  const pacOpts=agendaPacientes.map(p=>`<option value="${p.id}" ${a&&a.pacienteId===p.id?'selected':''}>${p.nome}</option>`).join('');
  openModal(`
    <div class="modalHead"><h3>${a?'Editar agendamento':'Novo agendamento'}</h3><button class="modalX" onclick="closeModal()">&times;</button></div>
    <div class="modalBody">
      <div class="field"><label>Paciente</label><select id="fPaciente">${pacOpts||'<option value="">Cadastre um paciente primeiro</option>'}</select></div>
      <div class="formRow">
        <div class="field"><label>Data</label><input type="date" id="fData" value="${a?a.data:agendaSelDia}"></div>
        <div class="field"><label>Horário</label><input type="time" id="fHora" value="${a?a.hora:'09:00'}"></div>
      </div>
      <div class="formRow">
        <div class="field"><label>Tipo</label><input id="fTipo" placeholder="Consulta, retorno, avaliação…" value="${a?a.tipo||'':''}"></div>
        <div class="field"><label>Profissional</label><input id="fProf" placeholder="Dr(a)." value="${a?a.profissional||'':''}"></div>
      </div>
      <div class="field"><label>Procedimento (opcional — baixa o estoque e lança o financeiro sozinho ao marcar "Atendido")</label>
        <select id="fProcedimento">
          <option value="">Nenhum / lançar manualmente</option>
          ${agendaProcedimentos.map(p=>`<option value="${p.id}" ${a&&a.procedimentoId===p.id?'selected':''}>${p.nome} — ${BRL(p.precoManual||precoSugeridoAgenda(p))}</option>`).join('')}
        </select>
      </div>
      <div class="field"><label>Observações</label><textarea id="fObs" rows="2">${a?a.obs||'':''}</textarea></div>
      ${a?`<div class="field"><label>Status</label><select id="fStatus">
        ${['agendado','confirmado','atendido','faltou','cancelado'].map(s=>`<option value="${s}" ${a.status===s?'selected':''}>${statusLabel(s)}</option>`).join('')}
      </select></div>`:''}
    </div>
    <div class="modalFoot">
      ${a?`<button class="btn danger" onclick="excluirAgendamento('${a.id}')">Excluir</button>`:''}
      <button class="btn" onclick="closeModal()">Cancelar</button>
      <button class="btn primary" onclick="salvarAgendamento(${a?`'${a.id}'`:'null'})">Salvar</button>
    </div>
  `);
}
async function salvarAgendamento(id){
  const pacienteId=$('fPaciente').value;
  if(!pacienteId){showToast('Selecione um paciente.','err');return;}
  const paciente=agendaPacientes.find(p=>p.id===pacienteId);
  const anterior=id?agendaData.find(a=>a.id===id):null;
  const obj={
    id:id||uid(), pacienteId, pacienteNome:paciente?paciente.nome:'', telefone:paciente?paciente.telefone:'',
    data:$('fData').value, hora:$('fHora').value, tipo:$('fTipo').value.trim(), profissional:$('fProf').value.trim(),
    procedimentoId:$('fProcedimento').value||'', obs:$('fObs').value.trim(), status: id ? $('fStatus').value : 'agendado',
    baixaFeita: anterior?anterior.baixaFeita:false
  };
  if(!obj.data||!obj.hora){showToast('Preencha data e horário.','err');return;}
  const virouAtendido = obj.status==='atendido' && (!anterior||anterior.status!=='atendido');
  if(virouAtendido && obj.procedimentoId && !obj.baixaFeita){
    await processarProcedimentoNaConsulta(obj);
    obj.baixaFeita=true;
  }
  const idx=agendaData.findIndex(a=>a.id===obj.id);
  if(idx>=0) agendaData[idx]=obj; else agendaData.push(obj);
  await saveList('agendamentos',agendaData);
  closeModal(); showToast(id?'Agendamento atualizado.':'Agendamento criado.','ok');
  agendaSelDia=obj.data; pintarAgenda();
}
async function processarProcedimentoNaConsulta(a){
  const proc=agendaProcedimentos.find(p=>p.id===a.procedimentoId);
  if(!proc) return;
  let precisaSalvarEstoque=false;
  (proc.itens||[]).forEach(it=>{
    const e=agendaEstoque.find(x=>x.id===it.estoqueId);
    if(e){ e.qtd=Math.max(0,Number(e.qtd||0)-Number(it.qtd||0)); precisaSalvarEstoque=true; }
  });
  if(precisaSalvarEstoque) await saveList('estoque',agendaEstoque);
  const custo=custoProcedimentoAgenda(proc);
  const preco=proc.precoManual||precoSugeridoAgenda(proc);
  const lanc=await loadList('lancamentos');
  lanc.push({id:uid(),tipo:'receita',valor:preco,descricao:proc.nome+' — '+a.pacienteNome,categoria:'Procedimento',data:a.data,natureza:'operacional',origem:'procedimento',agendamentoId:a.id});
  if(custo>0) lanc.push({id:uid(),tipo:'despesa',valor:custo,descricao:'Insumos: '+proc.nome+' — '+a.pacienteNome,categoria:'Insumos (CMV)',data:a.data,natureza:'cmv',origem:'procedimento',agendamentoId:a.id});
  await saveList('lancamentos',lanc);
  showToast('Estoque baixado e financeiro lançado automaticamente.','ok');
}
async function excluirAgendamento(id){
  if(!confirm('Excluir este agendamento?')) return;
  agendaData=agendaData.filter(a=>a.id!==id);
  await saveList('agendamentos',agendaData);
  closeModal(); showToast('Agendamento excluído.','ok'); pintarAgenda();
}
async function lembreteWhats(id){
  const a=agendaData.find(x=>x.id===id);
  if(!a) return;
  if(!a.telefone){showToast('Este paciente não tem telefone cadastrado.','err');return;}
  const cfg=await loadConfigClinica();
  const tpl=cfg.templateLembrete||'Olá {nome}! Passando para lembrar da sua consulta em {data} às {hora} na {clinica}. Para confirmar ou remarcar, é só responder por aqui.';
  const msg=tpl.replace('{nome}',a.pacienteNome).replace('{data}',fmtData(a.data)).replace('{hora}',a.hora).replace('{clinica}',clinicaNome);
  if(cfg.webhookAtivo && cfg.webhookWhats){
    try{
      await fetch(cfg.webhookWhats,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({telefone:a.telefone,mensagem:msg,paciente:a.pacienteNome,data:a.data,hora:a.hora,clinica:clinicaNome})});
      showToast('Lembrete enviado pelo fluxo automático.','ok'); return;
    }catch(e){ showToast('Webhook falhou, abrindo envio manual…','err'); }
  }
  window.open(waLink(a.telefone,msg),'_blank');
}
</script>
<script>
/* ================= PACIENTES ================= */
let pacientesData=[]; let pacientesBusca='';
async function renderPacientes(){
  $('topbarActs').innerHTML=`<button class="btn sm" onclick="exportarPacientesCSV()">Exportar CSV</button> <button class="btn primary" onclick="abrirModalPaciente()">+ Novo paciente</button>`;
  $('content').innerHTML='<div class="empty">Carregando…</div>';
  pacientesData=await loadList('pacientes');
  pintarPacientes();
}
function exportarPacientesCSV(){
  exportarCSV('pacientes.csv',[
    {titulo:'Nome',campo:'nome'},{titulo:'Telefone',campo:'telefone'},
    {titulo:'Nascimento',get:p=>p.nascimento?fmtData(p.nascimento):''},{titulo:'Observações',campo:'obs'}
  ],pacientesData);
}
function pintarPacientes(){
  const q=pacientesBusca.toLowerCase();
  const lista=pacientesData.filter(p=>!q||p.nome.toLowerCase().includes(q)||soDigitos(p.telefone).includes(soDigitos(q)));
  $('content').innerHTML=`
    <div class="toolbar"><input class="search" placeholder="Buscar por nome ou telefone…" oninput="pacientesBusca=this.value;pintarPacientes()" value="${pacientesBusca}"></div>
    <div class="panel">
      ${lista.length?`<table class="tbl"><thead><tr><th>Nome</th><th>Telefone</th><th>Nascimento</th><th></th></tr></thead><tbody>
        ${lista.map(p=>`<tr style="cursor:pointer" onclick="abrirModalPaciente('${p.id}')"><td>${p.nome}</td><td class="mono">${p.telefone||'—'}</td><td>${p.nascimento?fmtData(p.nascimento):'—'}</td>
          <td style="text-align:right"><button class="iconBtn" title="WhatsApp" onclick="event.stopPropagation();window.open(waLink('${p.telefone||''}',''),'_blank')">💬</button></td></tr>`).join('')}
      </tbody></table>`:`<div class="empty"><div class="big">Nenhum paciente ainda</div>Cadastre o primeiro paciente pra começar a usar a agenda.</div>`}
    </div>`;
}
function abrirModalPaciente(id){
  const p=id?pacientesData.find(x=>x.id===id):null;
  openModal(`
    <div class="modalHead"><h3>${p?'Editar paciente':'Novo paciente'}</h3><button class="modalX" onclick="closeModal()">&times;</button></div>
    <div class="modalBody">
      <div class="field"><label>Nome completo</label><input id="pNome" value="${p?p.nome:''}"></div>
      <div class="formRow">
        <div class="field"><label>Telefone (WhatsApp)</label><input id="pTel" placeholder="(11) 99999-9999" value="${p?p.telefone||'':''}"></div>
        <div class="field"><label>Nascimento</label><input type="date" id="pNasc" value="${p?p.nascimento||'':''}"></div>
      </div>
      <div class="field"><label>Observações / histórico</label><textarea id="pObs" rows="3">${p?p.obs||'':''}</textarea></div>
    </div>
    <div class="modalFoot">
      ${p?`<button class="btn" onclick="abrirProntuario('${p.id}')">Ver prontuário</button>`:''}
      ${p?`<button class="btn danger" onclick="excluirPaciente('${p.id}')">Excluir</button>`:''}
      <button class="btn" onclick="closeModal()">Cancelar</button>
      <button class="btn primary" onclick="salvarPaciente(${p?`'${p.id}'`:'null'})">Salvar</button>
    </div>
  `);
}

/* ---- Prontuário: evolução por consulta + anexos ---- */
let prontuarioPacienteId=null; let evolucoesData=[];
async function abrirProntuario(pacienteId){
  prontuarioPacienteId=pacienteId;
  const p=pacientesData.find(x=>x.id===pacienteId);
  evolucoesData=await loadList('evolucoes');
  pintarProntuario(p);
}
function pintarProntuario(p){
  const minhas=evolucoesData.filter(e=>e.pacienteId===prontuarioPacienteId).sort((a,b)=>b.data.localeCompare(a.data));
  openModal(`
    <div class="modalHead"><h3>Prontuário — ${p.nome}</h3><button class="modalX" onclick="closeModal()">&times;</button></div>
    <div class="modalBody">
      <div class="formRow">
        <div class="field"><label>Data</label><input type="date" id="evData" value="${hojeISO()}"></div>
        <div class="field"><label>Anexo (opcional)</label><input type="file" id="evAnexo" accept="image/*,.pdf"></div>
      </div>
      <div class="field"><label>Evolução / anotação da consulta</label><textarea id="evTexto" rows="3" placeholder="Queixa, exame, conduta, prescrição…"></textarea></div>
      <button class="btn primary sm" onclick="salvarEvolucao()">Adicionar ao prontuário</button>
      <div style="margin-top:18px;border-top:1px solid var(--line-soft);padding-top:14px">
        ${minhas.length? minhas.map(e=>`
          <div style="margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--line-soft)">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <b style="font-family:'Newsreader',serif">${fmtData(e.data)}</b>
              <button class="iconBtn" onclick="excluirEvolucao('${e.id}')">🗑</button>
            </div>
            <div style="font-size:13px;margin-top:4px;white-space:pre-wrap">${e.texto||''}</div>
            ${e.anexoNome?`<div style="margin-top:6px">${/\.(png|jpe?g|gif|webp)$/i.test(e.anexoNome)?`<img src="${e.anexoData}" style="max-width:100%;max-height:180px;border-radius:8px;border:1px solid var(--line)">`:`<a href="${e.anexoData}" download="${e.anexoNome}" class="tag">📎 ${e.anexoNome}</a>`}</div>`:''}
          </div>`).join('') : `<div class="empty">Nenhuma evolução registrada ainda.</div>`}
      </div>
    </div>
    <div class="modalFoot"><button class="btn" onclick="closeModal()">Fechar</button></div>
  `);
}
async function salvarEvolucao(){
  const texto=$('evTexto').value.trim(), data=$('evData').value;
  const file=$('evAnexo').files[0];
  if(!texto&&!file){showToast('Escreva algo ou anexe um arquivo.','err');return;}
  const obj={id:uid(),pacienteId:prontuarioPacienteId,data:data||hojeISO(),texto};
  if(file){
    if(file.size>1.5*1024*1024){showToast('Anexo muito grande (máx. 1,5MB).','err');return;}
    try{ obj.anexoNome=file.name; obj.anexoData=await lerImagemBase64(file); }catch(e){showToast('Não consegui ler o anexo.','err');return;}
  }
  evolucoesData.push(obj);
  await saveList('evolucoes',evolucoesData);
  showToast('Evolução adicionada.','ok');
  pintarProntuario(pacientesData.find(x=>x.id===prontuarioPacienteId));
}
async function excluirEvolucao(id){
  if(!confirm('Excluir esta anotação do prontuário?')) return;
  evolucoesData=evolucoesData.filter(e=>e.id!==id);
  await saveList('evolucoes',evolucoesData);
  pintarProntuario(pacientesData.find(x=>x.id===prontuarioPacienteId));
}
async function salvarPaciente(id){
  const nome=$('pNome').value.trim();
  if(!nome){showToast('Digite o nome do paciente.','err');return;}
  const obj={id:id||uid(),nome,telefone:$('pTel').value.trim(),nascimento:$('pNasc').value,obs:$('pObs').value.trim()};
  const idx=pacientesData.findIndex(p=>p.id===obj.id);
  if(idx>=0) pacientesData[idx]=obj; else pacientesData.push(obj);
  await saveList('pacientes',pacientesData);
  closeModal(); showToast(id?'Paciente atualizado.':'Paciente cadastrado.','ok'); pintarPacientes();
}
async function excluirPaciente(id){
  if(!confirm('Excluir este paciente? Os agendamentos já criados não serão apagados.')) return;
  pacientesData=pacientesData.filter(p=>p.id!==id);
  await saveList('pacientes',pacientesData);
  closeModal(); showToast('Paciente excluído.','ok'); pintarPacientes();
}
</script>
<script>
/* ================= FINANCEIRO ================= */
let lancData=[]; let contasData=[]; let financeiroMes=hojeISO().slice(0,7); let financeiroSubTab='lancamentos';
async function renderFinanceiro(){
  $('topbarActs').innerHTML='';
  $('content').innerHTML='<div class="empty">Carregando…</div>';
  [lancData,contasData]=await Promise.all([loadList('lancamentos'),loadList('contas')]);
  pintarFinanceiro();
}
function financeiroTabsHTML(){
  return `<div class="gateTabs" style="max-width:420px;margin-bottom:16px">
    <button class="gateTab ${financeiroSubTab==='lancamentos'?'on':''}" onclick="financeiroSubTab='lancamentos';pintarFinanceiro()">Lançamentos</button>
    <button class="gateTab ${financeiroSubTab==='contas'?'on':''}" onclick="financeiroSubTab='contas';pintarFinanceiro()">A pagar/receber</button>
    <button class="gateTab ${financeiroSubTab==='dre'?'on':''}" onclick="financeiroSubTab='dre';pintarFinanceiro()">DRE</button>
  </div>`;
}
function pintarFinanceiro(){
  if(financeiroSubTab==='contas') return pintarContas();
  if(financeiroSubTab==='dre') return pintarDRE();
  const doMes=lancData.filter(l=>l.data.slice(0,7)===financeiroMes).sort((a,b)=>b.data.localeCompare(a.data));
  const receita=doMes.filter(l=>l.tipo==='receita').reduce((s,l)=>s+Number(l.valor||0),0);
  const despesa=doMes.filter(l=>l.tipo==='despesa').reduce((s,l)=>s+Number(l.valor||0),0);
  $('content').innerHTML=`
    ${financeiroTabsHTML()}
    <div class="toolbar">
      <input type="month" class="gateInp" style="width:auto" value="${financeiroMes}" onchange="financeiroMes=this.value;pintarFinanceiro()">
      <span class="tag">Receita: <b class="mono">${BRL(receita)}</b></span>
      <span class="tag">Despesa: <b class="mono">${BRL(despesa)}</b></span>
      <span class="tag" style="background:var(--teal-soft);color:var(--teal)">Lucro: <b class="mono">${BRL(receita-despesa)}</b></span>
      <span style="flex:1"></span>
      <button class="btn sm" onclick="exportarFinanceiroCSV()">Exportar CSV</button>
      <button class="btn primary sm" onclick="abrirModalLancamento()">+ Lançamento</button>
    </div>
    <div class="panel">
      ${doMes.length?`<table class="tbl"><thead><tr><th>Data</th><th>Descrição</th><th>Categoria</th><th>Natureza</th><th>Tipo</th><th>Valor</th><th></th></tr></thead><tbody>
        ${doMes.map(l=>`<tr><td>${fmtData(l.data)}</td><td>${l.descricao}</td><td><span class="tag">${l.categoria||'—'}</span></td><td><span class="tag">${naturezaLabel(l.natureza)}</span></td>
          <td><span class="badge ${l.tipo==='receita'?'confirmado':'cancelado'}">${l.tipo==='receita'?'Receita':'Despesa'}</span></td>
          <td class="mono">${BRL(l.valor)}</td>
          <td style="text-align:right"><button class="iconBtn" onclick="abrirModalLancamento('${l.id}')">✎</button></td></tr>`).join('')}
      </tbody></table>`:`<div class="empty"><div class="big">Nenhum lançamento neste mês</div>Registre o que a clínica recebeu e gastou.</div>`}
    </div>`;
}
function naturezaLabel(n){ return {fixa:'Fixa',variavel:'Variável',cmv:'CMV (insumo)'}[n]||'Variável'; }
function exportarFinanceiroCSV(){
  const doMes=lancData.filter(l=>l.data.slice(0,7)===financeiroMes);
  exportarCSV('financeiro_'+financeiroMes+'.csv',[
    {titulo:'Data',get:l=>fmtData(l.data)},{titulo:'Descrição',campo:'descricao'},{titulo:'Categoria',campo:'categoria'},
    {titulo:'Natureza',get:l=>naturezaLabel(l.natureza)},
    {titulo:'Tipo',get:l=>l.tipo==='receita'?'Receita':'Despesa'},{titulo:'Valor',get:l=>Number(l.valor||0).toFixed(2).replace('.',',')}
  ],doMes);
}
function abrirModalLancamento(id){
  const l=id?lancData.find(x=>x.id===id):null;
  openModal(`
    <div class="modalHead"><h3>${l?'Editar lançamento':'Novo lançamento'}</h3><button class="modalX" onclick="closeModal()">&times;</button></div>
    <div class="modalBody">
      <div class="formRow">
        <div class="field"><label>Tipo</label><select id="lTipo"><option value="receita" ${l&&l.tipo==='receita'?'selected':''}>Receita (recebido)</option><option value="despesa" ${l&&l.tipo==='despesa'?'selected':''}>Despesa (gasto)</option></select></div>
