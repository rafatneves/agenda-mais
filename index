}

/* ================= DASHBOARD ================= */
async function renderDashboard(){
  $('content').innerHTML='<div class="empty">Carregando…</div>';
  const [agendamentos,lancamentos,estoque,pacientes,contas]=await Promise.all([
    loadList('agendamentos'),loadList('lancamentos'),loadList('estoque'),loadList('pacientes'),loadList('contas')
  ]);
  const hoje=hojeISO();
  const mesAtual=hoje.slice(0,7);
  const hojeAgend=agendamentos.filter(a=>a.data===hoje&&a.status!=='cancelado');
  const lancMes=lancamentos.filter(l=>l.data.slice(0,7)===mesAtual);
  const receitaMes=lancMes.filter(l=>l.tipo==='receita').reduce((s,l)=>s+Number(l.valor||0),0);
  const despesaMes=lancMes.filter(l=>l.tipo==='despesa').reduce((s,l)=>s+Number(l.valor||0),0);
