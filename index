<script>
'use strict';
/* ================= CONFIG / SUPABASE ================= */
const CFG_URL='agendamais:cfg:url', CFG_KEY='agendamais:cfg:key';
// Sem projeto padrão: cada clínica (ou cada revenda do Clara) conecta o próprio Supabase.
// Rode o SQL abaixo (uma vez, no SQL editor do Supabase) antes do primeiro uso:
/*
create table if not exists painel(grp text not null, k text not null, value jsonb, updated_at timestamptz default now(), primary key(grp,k));
alter table painel enable row level security;
create table if not exists workspace_members(user_id uuid references auth.users(id) primary key, grp text not null, role text default 'admin', created_at timestamptz default now());
alter table workspace_members enable row level security;
create table if not exists clinicas(grp text primary key, nome text not null, logo text, cor text, created_at timestamptz default now());
alter table clinicas enable row level security;

create policy painel_rw on painel for all using (grp in (select grp from workspace_members where user_id=auth.uid())) with check (grp in (select grp from workspace_members where user_id=auth.uid()));
create policy wm_own_select on workspace_members for select using (user_id=auth.uid());
create policy wm_own_insert on workspace_members for insert with check (user_id=auth.uid());
create policy clinicas_select_public on clinicas for select using (true);
create policy clinicas_insert_auth on clinicas for insert with check (auth.uid() is not null);
create policy clinicas_update_members on clinicas for update using (grp in (select grp from workspace_members where user_id=auth.uid())) with check (grp in (select grp from workspace_members where user_id=auth.uid()));
*/
let sb=null, sbUser=null, groupId=null, clinicaNome='';
function initSupabase(){
  const url=localStorage.getItem(CFG_URL), key=localStorage.getItem(CFG_KEY);
  if(url&&key&&window.supabase){sb=window.supabase.createClient(url,key);return true;}
  return false;
}
function showCfg(on){
  document.getElementById('cfgModal').classList.toggle('on',on);
  if(on){document.getElementById('cfgUrl').value=localStorage.getItem(CFG_URL)||'';document.getElementById('cfgKey').value=localStorage.getItem(CFG_KEY)||'';}
}
function saveCfg(){
  const url=document.getElementById('cfgUrl').value.trim(), key=document.getElementById('cfgKey').value.trim();
  const err=document.getElementById('cfgErr');
  if(!url||!key){err.textContent='Preencha URL e chave.';err.style.display='block';return;}
  localStorage.setItem(CFG_URL,url);localStorage.setItem(CFG_KEY,key);
  location.reload();
}

/* ================= AUTH ================= */
let authMode='login';
function setAuthTab(m){
  authMode=m;
  document.getElementById('tabLogin').classList.toggle('on',m==='login');
  document.getElementById('tabSignup').classList.toggle('on',m==='signup');
  document.getElementById('authBtn').textContent=m==='login'?'Entrar':'Criar conta';
  document.getElementById('authSub').textContent=m==='login'?'Acesse o painel da sua clínica.':'Leva menos de um minuto.';
  document.getElementById('authErr').style.display='none';
}
async function doAuth(){
  if(!sb){showCfg(true);return;}
  const email=document.getElementById('authEmail').value.trim(), pass=document.getElementById('authPass').value;
  const err=document.getElementById('authErr'); err.style.display='none';
  if(!email||!pass){err.textContent='Preencha e-mail e senha.';err.style.display='block';return;}
  try{
    let res;
    if(authMode==='login') res=await sb.auth.signInWithPassword({email,password:pass});
    else res=await sb.auth.signUp({email,password:pass});
    if(res.error) throw res.error;
    if(authMode==='signup'&&!res.data.session){
      err.style.color='var(--teal)';err.style.background='var(--teal-soft)';
      err.textContent='Conta criada! Se seu projeto exigir confirmação por e-mail, confirme antes de entrar.';
      err.style.display='block'; return;
    }
    await afterLogin();
  }catch(e){err.textContent=traduzErro(e.message);err.style.display='block';}
}
function traduzErro(m){
  if(/Invalid login credentials/i.test(m))return 'E-mail ou senha incorretos.';
  if(/already registered/i.test(m))return 'Esse e-mail já tem conta — tente entrar.';
  if(/Password should be/i.test(m))return 'Senha muito curta (mínimo 6 caracteres).';
  return m;
}
async function doLogout(){try{await sb.auth.signOut();}catch(e){} sbUser=null;groupId=null;location.reload();}

async function afterLogin(){
  const {data}=await sb.auth.getSession();
  sbUser=data&&data.session?data.session.user:null;
  if(!sbUser) return;
  const {data:wm}=await sb.from('workspace_members').select('grp').eq('user_id',sbUser.id).maybeSingle();
  if(wm&&wm.grp){ groupId=wm.grp; await bootApp(); }
  else{
    document.getElementById('gateAuth').style.display='none'; document.getElementById('gateOnboard').style.display='block';
    if(prefillCodigo){ setOnbTab('join'); $('onbCodigo').value=prefillCodigo; }
