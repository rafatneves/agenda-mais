}
async function excluirProcedimento(id){
  if(!confirm('Excluir este procedimento?')) return;
  procData=procData.filter(x=>x.id!==id);
  await saveList('procedimentos',procData);
  closeModal(); showToast('Procedimento excluído.','ok'); pintarProcedimentos();
}
</script>
