      <div class="panelHead"><h2>Pendentes</h2></div>
      ${pendentes.length?`<table class="tbl"><thead><tr><th>Vencimento</th><th>Descrição</th><th>Tipo</th><th>Valor</th><th></th></tr></thead><tbody>
        ${pendentes.map(c=>{
          const atrasada=c.vencimento<hoje;
          return `<tr><td class="${atrasada?'stockLow':''}">${fmtData(c.vencimento)}${atrasada?' · atrasada':''}</td><td>${c.descricao}</td>
          <td><span class="badge ${c.tipo==='receber'?'confirmado':'faltou'}">${c.tipo==='receber'?'A receber':'A pagar'}</span></td>
          <td class="mono">${BRL(c.valor)}</td>
          <td style="text-align:right;display:flex;gap:4px;justify-content:flex-end">
            <button class="btn sm" onclick="marcarContaPaga('${c.id}')">${c.tipo==='receber'?'Marcar recebida':'Marcar paga'}</button>
            <button class="iconBtn" onclick="abrirModalConta('${c.id}')">✎</button>
          </td></tr>`;
        }).join('')}
      </tbody></table>`:`<div class="empty"><div class="big">Nenhuma conta pendente</div>Cadastre contas a pagar ou a receber com data de vencimento.</div>`}
    </div>
    <div class="panel" style="margin-top:16px">
      <div class="panelHead"><h2>Últimas quitadas</h2></div>
      ${pagas.length?`<table class="tbl"><thead><tr><th>Vencimento</th><th>Descrição</th><th>Tipo</th><th>Valor</th></tr></thead><tbody>
        ${pagas.map(c=>`<tr><td>${fmtData(c.vencimento)}</td><td>${c.descricao}</td><td>${c.tipo==='receber'?'Recebida':'Paga'}</td><td class="mono">${BRL(c.valor)}</td></tr>`).join('')}
      </tbody></table>`:`<div class="empty">Nenhuma conta quitada ainda.</div>`}
    </div>`;
}
function abrirModalConta(id){
  const c=id?contasData.find(x=>x.id===id):null;
  openModal(`
    <div class="modalHead"><h3>${c?'Editar conta':'Nova conta'}</h3><button class="modalX" onclick="closeModal()">&times;</button></div>
    <div class="modalBody">
      <div class="field"><label>Tipo</label><select id="cTipo"><option value="pagar" ${c&&c.tipo==='pagar'?'selected':''}>A pagar</option><option value="receber" ${c&&c.tipo==='receber'?'selected':''}>A receber</option></select></div>
      <div class="field"><label>Descrição</label><input id="cDesc" placeholder="Ex: Aluguel de agosto" value="${c?c.descricao:''}"></div>
      <div class="formRow">
        <div class="field"><label>Valor (R$)</label><input type="number" step="0.01" id="cValor" value="${c?c.valor:''}"></div>
        <div class="field"><label>Vencimento</label><input type="date" id="cVenc" value="${c?c.vencimento:hojeISO()}"></div>
      </div>
