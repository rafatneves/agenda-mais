.btn:hover{background:var(--paper2)}
.btn.primary{background:var(--teal);color:#fff;border-color:var(--teal)}
.btn.primary:hover{opacity:.9}
.btn.danger{background:var(--coral-soft);color:var(--coral);border-color:var(--coral-soft)}
.btn.sm{padding:6px 10px;font-size:12px}
.tbl{width:100%;border-collapse:collapse}
.tbl th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--gray);padding:8px 18px;border-bottom:1px solid var(--line)}
.tbl td{padding:11px 18px;border-bottom:1px solid var(--line-soft);font-size:13.5px}
