<script>
/* ================= BOOT / ROUTER ================= */
let currentTab='dashboard';
const TAB_TITLES={dashboard:'Painel',agenda:'Agenda',pacientes:'Pacientes',financeiro:'Financeiro',estoque:'Estoque',procedimentos:'Procedimentos',relatorios:'Relatórios',config:'Configurações'};

