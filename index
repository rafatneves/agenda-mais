.modalHead{padding:18px 22px;border-bottom:1px solid var(--line-soft);display:flex;justify-content:space-between;align-items:center}
.modalHead h3{margin:0;font-size:17px}
.modalX{background:none;border:none;font-size:20px;color:var(--gray);line-height:1}
.modalBody{padding:20px 22px}
.modalFoot{padding:16px 22px;border-top:1px solid var(--line-soft);display:flex;justify-content:flex-end;gap:10px}

#toastWrap{position:fixed;bottom:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:8px}
.toast{background:var(--ink);color:#fff;padding:11px 16px;border-radius:var(--radius-sm);font-size:13px;box-shadow:0 8px 24px -8px #0006;
  animation:tin .18s ease}
.toast.ok{background:var(--teal)}
.toast.err{background:var(--coral)}
@keyframes tin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.agendaWrap{display:flex;gap:18px}
.agendaCal{width:220px;flex:none}
.miniCal{background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);padding:14px}
.miniCal .mcHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-weight:600;font-size:13px}
.miniCal .mcNav{background:none;border:none;color:var(--ink-soft);font-size:15px;padding:2px 6px}
.miniCal .mcGrid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;text-align:center;font-size:11.5px}
.miniCal .mcDow{color:var(--gray);padding:4px 0}
.miniCal .mcDay{padding:6px 0;border-radius:7px;cursor:pointer;color:var(--ink-soft)}
.miniCal .mcDay:hover{background:var(--paper2)}
.miniCal .mcDay.today{font-weight:700;color:var(--teal)}
.miniCal .mcDay.sel{background:var(--teal);color:#fff}
.miniCal .mcDay.off{color:var(--line)}
.dayTimeline{flex:1;position:relative;background:#fff;border:1px solid var(--line);border-radius:var(--radius-md);padding:6px 0}
.dtRow{display:flex;border-bottom:1px solid var(--line-soft);min-height:64px}
.dtRow:last-child{border-bottom:none}
.dtHour{width:64px;flex:none;text-align:right;padding:8px 12px 0 0;font-size:11.5px;color:var(--gray);font-family:'IBM Plex Mono',monospace}
.dtSlot{flex:1;position:relative;padding:6px 10px}
.apptCard{background:var(--teal-soft);border-left:3px solid var(--teal);border-radius:8px;padding:8px 11px;margin-bottom:5px;
  display:flex;justify-content:space-between;align-items:center;gap:8px;cursor:pointer;transition:.12s}
.apptCard:hover{filter:brightness(.97)}
.apptCard.faltou{background:var(--amber-soft);border-color:var(--amber)}
.apptCard.cancelado{background:var(--coral-soft);border-color:var(--coral);opacity:.7}
.apptCard.atendido{background:var(--line-soft);border-color:var(--gray)}
.apptCard .who{font-weight:600;font-size:13px}
.apptCard .what{font-size:12px;color:var(--ink-soft)}
.apptActs{display:flex;gap:4px}
.iconBtn{background:none;border:none;color:var(--ink-soft);font-size:14px;padding:3px 5px;border-radius:6px}
.iconBtn:hover{background:#fff}

.mark img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
.stockLow{color:var(--coral);font-weight:600}
.tag{display:inline-block;padding:2px 8px;border-radius:99px;background:var(--paper2);font-size:11px;color:var(--ink-soft)}
@media(max-width:860px){
  .sidebar{transform:translateX(-100%);transition:transform .2s}
  .sidebar.on{transform:translateX(0)}
  .main{margin-left:0}
  .menuBtn{display:block}
  .agendaWrap{flex-direction:column}
  .agendaCal{width:100%}
  .formRow{grid-template-columns:1fr}
}
</style>

