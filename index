<script>
/* ================= PROCEDIMENTOS (protocolo de insumos + precificação) ================= */
let procData=[]; let procEstoque=[]; let procItensTemp=[]; let procDraft={nome:'',margem:30,precoManual:''};
async function renderProcedimentos(){
  $('topbarActs').innerHTML=`<button class="btn primary" onclick="abrirModalProcedimento()">+ Procedimento</button>`;
  $('content').innerHTML='<div class="empty">Carregando…</div>';
  [procData,procEstoque]=await Promise.all([loadList('procedimentos'),loadList('estoque')]);
  pintarProcedimentos();
}
function custoProcedimento(p){
  return (p.itens||[]).reduce((s,it)=>{ const e=procEstoque.find(x=>x.id===it.estoqueId); return s+(e?Number(e.custoUnitario||0)*Number(it.qtd||0):0); },0);
}
function precoSugerido(p){
  const custo=custoProcedimento(p); const m=Number(p.margem||0);
  if(m<=0||m>=100) return custo;
  return custo/(1-m/100);
}
function pintarProcedimentos(){
  $('content').innerHTML=`<div class="panel">
    ${procData.length?`<table class="tbl"><thead><tr><th>Procedimento</th><th>Insumos</th><th>Custo</th><th>Margem</th><th>Preço sugerido</th><th></th></tr></thead><tbody>
      ${procData.map(p=>{
        const custo=custoProcedimento(p), sugerido=precoSugerido(p);
        return `<tr><td>${p.nome}</td><td>${(p.itens||[]).length} item(ns)</td><td class="mono">${BRL(custo)}</td><td>${p.margem||0}%</td>
          <td class="mono" style="font-weight:600">${BRL(p.precoManual||sugerido)}</td>
          <td style="text-align:right"><button class="iconBtn" onclick="abrirModalProcedimento('${p.id}')">✎</button></td></tr>`;
      }).join('')}
    </tbody></table>`:`<div class="empty"><div class="big">Nenhum procedimento cadastrado</div>Cadastre os procedimentos com os insumos que cada um consome — o custo e o preço sugerido são calculados sozinhos.</div>`}
  </div>`;
}
function abrirModalProcedimento(id){
  const p=id?procData.find(x=>x.id===id):null;
  procItensTemp = p ? JSON.parse(JSON.stringify(p.itens||[])) : [];
  procDraft = p ? {nome:p.nome,margem:p.margem||30,precoManual:p.precoManual||''} : {nome:'',margem:30,precoManual:''};
  renderModalProcedimento(id||null);
}
function renderModalProcedimento(id){
  const custo=procItensTemp.reduce((s,it)=>{ const e=procEstoque.find(x=>x.id===it.estoqueId); return s+(e?Number(e.custoUnitario||0)*Number(it.qtd||0):0); },0);
  const margem=Number(procDraft.margem||0);
  const sugerido = margem>0&&margem<100 ? custo/(1-margem/100) : custo;
  openModal(`
    <div class="modalHead"><h3>${id?'Editar procedimento':'Novo procedimento'}</h3><button class="modalX" onclick="closeModal()">&times;</button></div>
    <div class="modalBody">
      <div class="field"><label>Nome do procedimento</label><input id="prNome" placeholder="Ex: Limpeza de pele" value="${procDraft.nome||''}" onchange="procDraft.nome=this.value"></div>
      <div class="field"><label>Insumos consumidos</label>
        <div id="prItensList">${procItensTemp.map((it,idx)=>{
          const e=procEstoque.find(x=>x.id===it.estoqueId);
          return `<div style="display:flex;gap:8px;align-items:center;margin-bottom:6px">
            <span style="flex:1;font-size:13px">${e?e.nome:'(item removido)'}</span>
            <span class="mono" style="font-size:12px;color:var(--ink-soft)">${it.qtd} ${e?e.unidade||'':''}</span>
            <button class="iconBtn" onclick="removerItemProc(${idx},'${id||''}')">🗑</button>
          </div>`;
        }).join('') || '<p style="font-size:12.5px;color:var(--gray)">Nenhum insumo adicionado ainda.</p>'}</div>
        <div style="display:flex;gap:8px;margin-top:8px">
          <select id="prItemSel" style="flex:1;padding:9px 11px;border:1px solid var(--line);border-radius:7px;background:var(--paper)">
            ${procEstoque.map(e=>`<option value="${e.id}">${e.nome} (${BRL(e.custoUnitario||0)}/${e.unidade||'un'})</option>`).join('') || '<option value="">Cadastre itens no Estoque primeiro</option>'}
          </select>
          <input type="number" step="0.01" id="prItemQtd" placeholder="Qtd" value="1" style="width:80px;padding:9px 11px;border:1px solid var(--line);border-radius:7px">
          <button class="btn sm" onclick="adicionarItemProc('${id||''}')">Adicionar</button>
        </div>
      </div>
      <div class="formRow">
        <div class="field"><label>Margem de lucro desejada (%)</label><input type="number" id="prMargem" value="${margem}" oninput="procDraft.margem=this.value;atualizarPrecoModal()"></div>
        <div class="field"><label>Preço manual (opcional, sobrepõe o sugerido)</label><input type="number" step="0.01" id="prPrecoManual" value="${procDraft.precoManual||''}" onchange="procDraft.precoManual=this.value"></div>
      </div>
      <div class="card" style="background:var(--teal-soft);border:none">
        <div style="display:flex;justify-content:space-between;font-size:13px"><span>Custo dos insumos</span><b class="mono" id="prCustoView">${BRL(custo)}</b></div>
        <div style="display:flex;justify-content:space-between;font-size:14px;margin-top:4px"><span>Preço sugerido</span><b class="mono" id="prSugeridoView" style="color:var(--teal)">${BRL(sugerido)}</b></div>
      </div>
    </div>
