async function salvarWebhook(){
  const cfg=await loadConfigClinica();
  cfg.webhookWhats=$('cfgWebhook').value.trim();
  cfg.webhookAtivo=$('cfgWebhookOn').checked;
  await store.set('clinica:config',JSON.stringify(cfg));
  showToast('Configuração de envio automático salva.','ok');
}
async function testarWebhook(){
  const url=$('cfgWebhook').value.trim();
  if(!url){showToast('Cole a URL do webhook primeiro.','err');return;}
  try{
    await fetch(url,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({telefone:'',mensagem:'Mensagem de teste do Agenda+',paciente:'Teste',data:hojeISO(),hora:'10:00',clinica:clinicaNome})});
    showToast('Teste enviado (confira no seu Zapier/Make/n8n se chegou).','ok');
  }catch(e){ showToast('Não consegui alcançar essa URL.','err'); }
}
function lerImagemBase64(file){
  return new Promise((res,rej)=>{
    const r=new FileReader();
    r.onload=()=>res(r.result);
    r.onerror=()=>rej(new Error('Falha ao ler a imagem'));
    r.readAsDataURL(file);
  });
}
async function salvarMarca(){
  const cfg=await loadConfigClinica();
  cfg.nomeExibicao=$('cfgNomeExib').value.trim();
  cfg.corPrincipal=$('cfgCor').value;
  const file=$('cfgLogoFile').files[0];
  if(file){
    if(file.size>800*1024){ showToast('Escolha uma imagem menor (até 800KB).','err'); return; }
    try{ cfg.logo=await lerImagemBase64(file); }catch(e){ showToast('Não consegui ler essa imagem.','err'); return; }
  }
  await store.set('clinica:config',JSON.stringify(cfg));
  await syncClinicaPublica(cfg);
  aplicarMarca(cfg);
  try{ localStorage.setItem('agendamais:lastBrand',JSON.stringify({codigo:groupId,nome:cfg.nomeExibicao||clinicaNome,logo:cfg.logo||'',cor:cfg.corPrincipal||''})); }catch(e){}
  showToast('Marca atualizada.','ok'); renderConfig();
}
function syncClinicaPublica(cfg){
  if(sb && groupId && groupId!=='demo'){
    return sb.from('clinicas').update({logo:cfg.logo||null,cor:cfg.corPrincipal||null}).eq('grp',groupId).then(()=>{},()=>{});
  }
  return Promise.resolve();
}
async function removerLogo(){
  const cfg=await loadConfigClinica();
  delete cfg.logo;
  await store.set('clinica:config',JSON.stringify(cfg));
  await syncClinicaPublica(cfg);
  aplicarMarca(cfg); showToast('Logo removida.','ok'); renderConfig();
}
async function salvarConfig(){
  const cfg=await loadConfigClinica();
  cfg.templateLembrete=$('cfgTpl').value;
  await store.set('clinica:config',JSON.stringify(cfg));
  showToast('Configurações salvas.','ok');
}

/* ================= INIT ================= */
(async function init(){
  setAuthTab('login'); setOnbTab('create');
  document.getElementById('modalBg').addEventListener('click',e=>{if(e.target.id==='modalBg')closeModal();});
  document.getElementById('cfgModal').addEventListener('click',e=>{if(e.target.id==='cfgModal')showCfg(false);});
  try{
    const cached=JSON.parse(localStorage.getItem('agendamais:lastBrand')||'null');
    if(cached){
      if(cached.cor){ document.documentElement.style.setProperty('--teal',cached.cor); document.documentElement.style.setProperty('--teal-soft',`color-mix(in srgb, ${cached.cor} 16%, white)`); }
      if(cached.logo) $('gateMark').innerHTML=`<img src="${cached.logo}" alt="Logo">`;
      if(cached.nome) $('gateName').textContent=cached.nome;
    }
  }catch(e){}
  const codigoUrl=(new URLSearchParams(location.search)).get('c');
  if(codigoUrl) prefillCodigo=codigoUrl.trim().toUpperCase();
  if(!initSupabase()){ showCfg(true); return; }
  if(prefillCodigo){
    try{
      const {data}=await sb.from('clinicas').select('nome,logo,cor').eq('grp',prefillCodigo).maybeSingle();
      if(data){
        if(data.cor){ document.documentElement.style.setProperty('--teal',data.cor); document.documentElement.style.setProperty('--teal-soft',`color-mix(in srgb, ${data.cor} 16%, white)`); }
        $('gateMark').innerHTML = data.logo ? `<img src="${data.logo}" alt="Logo">` : 'A+';
        $('gateName').textContent = data.nome || 'Agenda+';
        $('authSub').textContent = `Acesse o painel de ${data.nome}.`;
      }
    }catch(e){}
  }
  try{
    const {data}=await sb.auth.getSession();
    if(data&&data.session){ await afterLogin(); }
  }catch(e){ console.error(e); }
})();
</script>
<script>
/* Link de convite: agenda-mais.html?c=CODIGO já mostra a marca da clínica e pré-preenche o código de acesso. */
function linkConviteAtual(){
  const url=new URL(location.href); url.search=''; url.searchParams.set('c',groupId);
  return url.toString();
}
async function copiarLinkConvite(){
  try{ await navigator.clipboard.writeText(linkConviteAtual()); showToast('Link copiado!','ok'); }
  catch(e){ showToast('Não consegui copiar automaticamente — selecione e copie manualmente.','err'); }
}

