      if(!codigo){err.textContent='Digite o código da clínica.';err.style.display='block';return;}
      const {data:cli,error:e0}=await sb.from('clinicas').select('nome').eq('grp',codigo).maybeSingle();
      if(e0) throw e0;
      if(!cli){err.textContent='Código não encontrado. Confira com a sua clínica.';err.style.display='block';return;}
      const {error:e2}=await sb.from('workspace_members').insert({user_id:sbUser.id,grp:codigo,role:'equipe'});
      if(e2) throw e2;
      groupId=codigo; clinicaNome=cli.nome;
    }
    await bootApp();
  }catch(e){err.textContent=traduzErro(e.message);err.style.display='block';}
}

/* ================= STORE (chave/valor por clínica) ================= */
let demoMode=false;
const mem={};
const store={
  async get(k){
    if(demoMode){ try{ const v=localStorage.getItem('agendamais:demo:'+k); return v; }catch(e){ return mem[k]??null; } }
    if(!sb||!groupId) return null;
    if(k in mem) return mem[k];
    try{
      const {data,error}=await sb.from('painel').select('value').eq('grp',groupId).eq('k',k).maybeSingle();
      if(error) throw error;
      const v=(data&&data.value!=null)?(typeof data.value==='string'?data.value:JSON.stringify(data.value)):null;
      mem[k]=v; return v;
    }catch(e){ return mem[k]??null; }
  },
  async set(k,v){
    mem[k]=v;
    if(demoMode){ try{ localStorage.setItem('agendamais:demo:'+k,v); }catch(e){} return; }
    if(!sb||!groupId) return;
    try{ await sb.from('painel').upsert({grp:groupId,k,value:v,updated_at:new Date().toISOString()},{onConflict:'grp,k'}); }
    catch(e){ showToast('Não foi possível salvar agora. Verifique sua internet.','err'); }
  }
};

